{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Raw Job Data Schema",
  "description": "Raw job records from public recruitment pages. Each row preserves source text and collection timestamp.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "job_id": {"type": "string", "minLength": 1},
    "site": {"type": "string", "minLength": 1},
    "URL_Goc": {"type": "string", "minLength": 1, "format": "uri"},
    "Timestamp": {"type": "string", "format": "date-time"},
    "title": {"type": "string", "description": "Tiêu đề nguyên bản."},
    "company": {"type": "string", "description": "Tên công ty nguyên bản."},
    "location": {"type": "string", "description": "Địa điểm nguyên bản."},
    "salary_raw": {"type": "string", "description": "Mức lương gốc, chưa chuẩn hóa."},
    "experience_raw": {"type": "string", "description": "Kinh nghiệm yêu cầu nguyên bản."},
    "description": {"type": "string", "description": "Mô tả công việc nguyên bản."},
    "requirements": {"type": "string", "description": "Yêu cầu chi tiết nguyên bản."},
    "benefits": {"type": "string", "description": "Quyền lợi nguyên bản."},
    "skills_raw": {"type": "string"},
    "work_model_raw": {"type": "string"},
    "employment_type_raw": {"type": "string"},
    "posted_at_raw": {"type": "string"},
    "keyword_search": {
      "oneOf": [
        {"type": "string"},
        {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      ]
    }
  },
  "required": ["job_id", "site", "URL_Goc", "Timestamp", "title", "company", "location", "salary_raw", "experience_raw", "description", "requirements", "benefits"]
}
